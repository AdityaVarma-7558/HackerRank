# Copy to .env in the repository root. .env is gitignored -- never commit real keys.

# Needed for: npm run generate -- --model claude-opus-5
ANTHROPIC_API_KEY=

# Needed for: npm run generate -- --model gpt-5.6-sol
OPENAI_API_KEY=

# Optional: override the model id if your account exposes a different API slug.
# CLAUDE_OPUS5_MODEL_ID=
# OPENAI_MODEL_ID=

# Optional: raise if a response is reported as truncated.
ANTHROPIC_MAX_TOKENS=32000
OPENAI_MAX_TOKENS=32000
